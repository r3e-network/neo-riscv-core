<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Akka.TestKit" Version="1.5.55" />
    <PackageReference Include="Akka.TestKit.MSTest" Version="1.5.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="MSTest" Version="$(MSTestVersion)" />
    <PackageReference Include="Namotion.Reflection" Version="3.4.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="SmartContract\Manifest\TestFile\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="GasTests\Fixtures\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="test.config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Neo.Extensions\Neo.Extensions.csproj" />
    <ProjectReference Include="..\..\src\Neo\Neo.csproj" />
    <ProjectReference Include="..\..\..\neo-riscv-vm\compat\Neo.Riscv.Adapter\Neo.Riscv.Adapter.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <RiscvAdapterDll>..\..\..\neo-riscv-vm\compat\Neo.Riscv.Adapter\bin\$(Configuration)\net10.0\Neo.Riscv.Adapter.dll</RiscvAdapterDll>
    <RiscvHostLibRelease>..\..\..\neo-riscv-vm\target\release\libneo_riscv_host.so</RiscvHostLibRelease>
    <RiscvHostLibDebug>..\..\..\neo-riscv-vm\target\debug\libneo_riscv_host.so</RiscvHostLibDebug>
    <RiscvAdapterPluginDir>$(OutDir)Plugins\Neo.Riscv.Adapter</RiscvAdapterPluginDir>
  </PropertyGroup>

  <Target Name="StageRiscvAdapterPluginForCoreTests" AfterTargets="Build">
    <MakeDir Directories="$(RiscvAdapterPluginDir)" />
    <Copy SourceFiles="$(RiscvAdapterDll)"
          DestinationFiles="$(RiscvAdapterPluginDir)\Neo.Riscv.Adapter.dll"
          SkipUnchangedFiles="true"
          Condition="Exists('$(RiscvAdapterDll)')" />
    <Copy SourceFiles="$(RiscvHostLibRelease)"
          DestinationFiles="$(RiscvAdapterPluginDir)\libneo_riscv_host.so"
          SkipUnchangedFiles="true"
          Condition="Exists('$(RiscvHostLibRelease)')" />
    <Copy SourceFiles="$(RiscvHostLibDebug)"
          DestinationFiles="$(RiscvAdapterPluginDir)\libneo_riscv_host.so"
          SkipUnchangedFiles="true"
          Condition="!Exists('$(RiscvHostLibRelease)') and Exists('$(RiscvHostLibDebug)')" />
  </Target>

</Project>
