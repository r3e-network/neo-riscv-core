<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Akka.TestKit" Version="1.5.55" />
    <PackageReference Include="Akka.TestKit.MSTest" Version="1.5.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="MSTest" Version="$(MSTestVersion)" />
    <PackageReference Include="Namotion.Reflection" Version="3.4.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="SmartContract\Manifest\TestFile\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="GasTests\Fixtures\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="test.config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Neo.Extensions\Neo.Extensions.csproj" />
    <ProjectReference Include="..\..\src\Neo\Neo.csproj" />
    <ProjectReference Include="..\..\..\neo-riscv-vm\dotnet\Neo.Riscv.Adapter\Neo.Riscv.Adapter.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <RiscvAdapterDll>..\..\..\neo-riscv-vm\dotnet\Neo.Riscv.Adapter\bin\$(Configuration)\net10.0\Neo.Riscv.Adapter.dll</RiscvAdapterDll>
    <RiscvAdapterDepsJson>..\..\..\neo-riscv-vm\dotnet\Neo.Riscv.Adapter\bin\$(Configuration)\net10.0\Neo.Riscv.Adapter.deps.json</RiscvAdapterDepsJson>
    <RiscvHostLibFileName Condition="$([MSBuild]::IsOSPlatform('Windows'))">neo_riscv_host.dll</RiscvHostLibFileName>
    <RiscvHostLibFileName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libneo_riscv_host.dylib</RiscvHostLibFileName>
    <RiscvHostLibFileName Condition="'$(RiscvHostLibFileName)' == ''">libneo_riscv_host.so</RiscvHostLibFileName>
    <RiscvHostLibRelease>..\..\..\neo-riscv-vm\target\release\$(RiscvHostLibFileName)</RiscvHostLibRelease>
    <RiscvHostLibDebug>..\..\..\neo-riscv-vm\target\debug\$(RiscvHostLibFileName)</RiscvHostLibDebug>
    <RiscvAdapterPluginDir>$(TargetDir)Plugins/Neo.Riscv.Adapter</RiscvAdapterPluginDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(RiscvAdapterDll)" Link="Plugins/Neo.Riscv.Adapter/Neo.Riscv.Adapter.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(RiscvAdapterDepsJson)" Link="Plugins/Neo.Riscv.Adapter/Neo.Riscv.Adapter.deps.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(RiscvHostLibRelease)" Link="Plugins/Neo.Riscv.Adapter/$(RiscvHostLibFileName)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(RiscvHostLibRelease)')" />
    <None Include="$(RiscvHostLibDebug)" Link="Plugins/Neo.Riscv.Adapter/$(RiscvHostLibFileName)" CopyToOutputDirectory="PreserveNewest" Condition="!Exists('$(RiscvHostLibRelease)') and Exists('$(RiscvHostLibDebug)')" />
  </ItemGroup>

</Project>
